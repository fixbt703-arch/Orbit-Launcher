    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.1.3" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" /><PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
  </ItemGroup>
</Project>
