<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrbitLauncher</AssemblyName>
    <RootNamespace>OrbitLauncher</RootNamespace>
    <Version>1.2.0</Version>
    <AssemblyTitle>Orbit Launcher</AssemblyTitle>
    <Product>Orbit Launcher</Product>
    <Description>Космический Minecraft Launcher для Windows</Description>
    <Company>Orbit Launcher</Company>
    <Authors>Orbit Launcher contributors</Authors>
    <Copyright>Copyright © Orbit Launcher contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>Assets\OrbitLauncher.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression makes a single-file app look more like a runtime packer to AV heuristics. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\OrbitLauncher.png" />
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.1.3" />
  </ItemGroup>
</Project>
