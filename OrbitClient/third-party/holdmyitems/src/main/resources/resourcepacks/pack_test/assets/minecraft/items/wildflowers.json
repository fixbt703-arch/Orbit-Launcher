{
  "model": {
    "type": "minecraft:condition",
    "property": "holdmyitems:enabled",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui",
            "fixed",
            "ground"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/wildflowers_2d"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/wildflowers_3d"
      }
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "minecraft:item/wildflowers"
    }
  }
}
