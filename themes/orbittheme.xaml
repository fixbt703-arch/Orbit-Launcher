<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:utilities="clr-namespace:OrbitLauncher.Utilities" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
  <utilities:ComboBoxSelectionTextConverter x:Key="ComboBoxSelectionTextConverter" />
  <utilities:IconGeometryConverter x:Key="IconGeometryConverter" />
  <Color x:Key="BackgroundColor">#0C111C</Color>
  <Color x:Key="PanelColor">#121827</Color>
  <Color x:Key="CardColor">#171E2E</Color>
  <Color x:Key="CardHoverColor">#222C40</Color>
  <Color x:Key="BorderColor">#303D55</Color>
  <Color x:Key="PrimaryColor">#B39CFF</Color>
  <Color x:Key="PrimaryLightColor">#D9CEFF</Color>
  <Color x:Key="AccentColor">#79D7EF</Color>
  <Color x:Key="TextColor">#F4F6FF</Color>
  <Color x:Key="MutedTextColor">#B5C2D8</Color>
  <Color x:Key="DangerColor">#FF91AA</Color>
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
  <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
  <SolidColorBrush x:Key="SubtleCardBrush" Color="#121827" />
  <SolidColorBrush x:Key="TitleBarFrameBrush" Color="#0C111C" />
  <SolidColorBrush x:Key="NavigationFrameBrush" Color="#0C111C" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="ControlBrush" Color="#222C42" />
  <SolidColorBrush x:Key="InputBrush" Color="#101828" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#352E58" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#C8B7FF" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#201735" />
  <SolidColorBrush x:Key="FocusBrush" Color="#D9CEFF" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#F20C1322" />
  <SolidColorBrush x:Key="SoftAccentBrush" Color="#2C3155" />
  <SolidColorBrush x:Key="NavigationSelectionBrush" Color="#2C3155" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#74DDB7" />
  <SolidColorBrush x:Key="WarningBrush" Color="#F4CD87" />
  <SolidColorBrush x:Key="DividerBrush" Color="#283348" />
  <SolidColorBrush x:Key="ThumbBrush" Color="#60718E" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#697B99" />
  <!-- Standard backdrop: quiet tonal depth, distinct from user image backgrounds. -->
  <LinearGradientBrush x:Key="DefaultShellBrush" StartPoint="0,0" EndPoint="0.85,1">
    <GradientStop Color="#171D30" Offset="0" /><GradientStop Color="#0F1523" Offset="0.42" /><GradientStop Color="#0C111C" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RecentSurfaceBrush" StartPoint="0,0" EndPoint="1,0.6">
    <GradientStop Color="#29263E" Offset="0" /><GradientStop Color="#222A40" Offset="0.55" /><GradientStop Color="#1C263B" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="RecentBorderBrush" Color="#4C4565" />
  <SolidColorBrush x:Key="RecentOrbitBrush" Color="#22B39CFF" />
  <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#6B618C" />
  <PathGeometry x:Key="SmoothMoreGeometry" Figures="M4.25 12a.75 .75 0 1 0 1.5 0a.75 .75 0 1 0 -1.5 0 M11.25 12a.75 .75 0 1 0 1.5 0a.75 .75 0 1 0 -1.5 0 M18.25 12a.75 .75 0 1 0 1.5 0a.75 .75 0 1 0 -1.5 0" />
  <PathGeometry x:Key="SmoothRepairGeometry" Figures="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5" />
  <PathGeometry x:Key="SmoothImportGeometry" Figures="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2 M7 11l5 5l5 -5 M12 4v12" />
  <PathGeometry x:Key="SmoothFolderGeometry" Figures="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2" />
  <PathGeometry x:Key="SmoothTrashGeometry" Figures="M4 7h16 M10 11v6 M14 11v6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
  <PathGeometry x:Key="SmoothPlayGeometry" Figures="M8.4 5.1 C7.75 4.7 7 5.2 7 6 L7 18 C7 18.8 7.75 19.3 8.4 18.9 L18.5 12.9 C19.15 12.5 19.15 11.5 18.5 11.1 Z" />
  <PathGeometry x:Key="SmoothHeartGeometry" Figures="M12 21s-9 -5.6 -9 -11.5a5 5 0 0 1 9 -3a5 5 0 0 1 9 3c0 5.9 -9 11.5 -9 11.5z" />
  <PathGeometry x:Key="SmoothClockGeometry" Figures="M12 3a9 9 0 1 0 0 18a9 9 0 0 0 0 -18 M12 7v5l3 2" />
  <Style x:Key="OrbitFocus" TargetType="{x:Type Control}">
    <Setter Property="Template"><Setter.Value><ControlTemplate><Border Margin="2" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SmoothActionIcon" TargetType="{x:Type ContentControl}">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContentControl}">
          <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
            <Canvas Width="24" Height="24">
              <Path Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconGeometryConverter}}" Fill="{x:Null}" />
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <SolidColorBrush x:Key="PrimaryGradient" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="SpaceGradient" Color="{StaticResource BackgroundColor}" />
  <Style x:Key="{x:Type Window}" TargetType="{x:Type Window}">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="utilities:InterfaceMotion.Enabled" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="shell:WindowChrome.WindowChrome"><Setter.Value>
      <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="TitleText" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="27" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="MutedText" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Border" utilities:InterfaceMotion.Fill="{TemplateBinding Control.Background}" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.Fill" Value="{DynamicResource PrimaryHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.TargetOpacity" Value="0.72" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.TargetOpacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Border" utilities:InterfaceMotion.Fill="{TemplateBinding Control.Background}" utilities:InterfaceMotion.Stroke="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.Fill" Value="{DynamicResource CardHoverBrush}" />
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.Stroke" Value="{DynamicResource BorderBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.Stroke" Value="{DynamicResource PrimaryLightBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.TargetOpacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.TargetOpacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}" />
  <Style x:Key="GalleryToolbarButton" TargetType="{x:Type Button}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OrbitFocus}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="GalleryButtonBorder" utilities:InterfaceMotion.Fill="{TemplateBinding Control.Background}" utilities:InterfaceMotion.Stroke="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="9">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="GalleryButtonBorder" Property="utilities:InterfaceMotion.Fill" Value="{DynamicResource CardHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="GalleryButtonBorder" Property="utilities:InterfaceMotion.Fill" Value="{DynamicResource CardHoverBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="GalleryButtonBorder" Property="utilities:InterfaceMotion.Stroke" Value="{DynamicResource PrimaryLightBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OrbitFocus}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" /><Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="LinkButton" TargetType="{x:Type Button}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OrbitFocus}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryLightBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <TextBlock Name="Text" Text="{TemplateBinding ContentControl.Content}" Foreground="{TemplateBinding Control.Foreground}" TextDecorations="Underline" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Text" Property="TextBlock.Foreground" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Text" Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NavButton" TargetType="{x:Type RadioButton}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OrbitFocus}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border Name="Border" utilities:InterfaceMotion.Fill="{TemplateBinding Control.Background}" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.Fill" Value="{DynamicResource CardHoverBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.Fill" Value="{DynamicResource SelectionBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource PrimaryLightBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OrbitFocus}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource InputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{DynamicResource PrimaryLightBrush}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Border" utilities:InterfaceMotion.Fill="{TemplateBinding Control.Background}" utilities:InterfaceMotion.Stroke="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8">
            <ScrollViewer Name="PART_ContentHost" Padding="{TemplateBinding Control.Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.Stroke" Value="{DynamicResource ControlHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="utilities:InterfaceMotion.Stroke" Value="{DynamicResource PrimaryBrush}" />
            </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type PasswordBox}" TargetType="{x:Type PasswordBox}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OrbitFocus}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource InputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OrbitFocus}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource InputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <Border Name="ComboBorder" utilities:InterfaceMotion.Fill="{TemplateBinding Control.Background}" utilities:InterfaceMotion.Stroke="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8" />
            <TextBlock Name="SelectedText" Visibility="Collapsed" Margin="12,0,38,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{TemplateBinding Control.Foreground}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
              <TextBlock.Text>
                <MultiBinding Converter="{StaticResource ComboBoxSelectionTextConverter}">
                  <Binding Path="SelectedItem" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="DisplayMemberPath" RelativeSource="{RelativeSource TemplatedParent}" />
                  <Binding Path="SelectedItem.Content" RelativeSource="{RelativeSource TemplatedParent}" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <ContentPresenter Name="SelectedContent" Margin="12,0,38,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding SelectedItem}" ContentTemplate="{TemplateBinding ItemTemplate}" TextElement.Foreground="{TemplateBinding Foreground}" />
            <ContentControl Content="" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource SmoothActionIcon}" Foreground="{DynamicResource MutedTextBrush}" />
            <ToggleButton Background="#00FFFFFF" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border Background="#00FFFFFF" />
                </ControlTemplate>
              </Control.Template>
            </ToggleButton>
            <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
              <Border MaxHeight="330" Margin="0,5,0,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="5" MinWidth="{Binding PlacementTarget.ActualWidth, ElementName=PART_Popup}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ItemTemplate" Value="{x:Null}">
              <Setter TargetName="SelectedText" Property="Visibility" Value="Visible" />
              <Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ComboBorder" Property="utilities:InterfaceMotion.Stroke" Value="{DynamicResource ControlHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="ComboBorder" Property="utilities:InterfaceMotion.Stroke" Value="{DynamicResource PrimaryBrush}" />
            </Trigger>
            <Trigger Property="ComboBox.IsDropDownOpen" Value="True">
              <Setter TargetName="ComboBorder" Property="utilities:InterfaceMotion.Stroke" Value="{DynamicResource PrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border Name="ItemBorder" utilities:InterfaceMotion.Fill="{TemplateBinding Control.Background}" utilities:InterfaceMotion.Stroke="#00FFFFFF" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
            <Grid>
              <ContentPresenter Margin="0,0,28,0" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
              <Border Name="SelectionMark" Width="20" Height="20" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Background="{DynamicResource PrimaryBrush}">
                <ContentControl Content="" Width="10" Height="10" Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SmoothActionIcon}" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
              <Setter TargetName="ItemBorder" Property="utilities:InterfaceMotion.Fill" Value="{DynamicResource CardHoverBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="ItemBorder" Property="utilities:InterfaceMotion.Fill" Value="{DynamicResource SelectionBrush}" />
              <Setter TargetName="ItemBorder" Property="utilities:InterfaceMotion.Stroke" Value="{DynamicResource PrimaryLightBrush}" />
              <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource InputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBox}">
          <Border utilities:InterfaceMotion.Fill="{TemplateBinding Control.Background}" utilities:InterfaceMotion.Stroke="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8">
            <ScrollViewer Padding="{TemplateBinding Control.Padding}" Focusable="False">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ListBoxItem}" TargetType="{x:Type ListBoxItem}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource OrbitFocus}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
