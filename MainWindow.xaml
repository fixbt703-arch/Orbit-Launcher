<Window x:Class="OrbitLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:OrbitLauncher.Models"
        xmlns:utilities="clr-namespace:OrbitLauncher.Utilities"
        Title="Orbit Launcher" Width="1320" Height="820" MinWidth="1060" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent">
    <Window.Resources>
        <utilities:InstanceIconConverter x:Key="InstanceIconConverter" />
    </Window.Resources>
    <Border Style="{StaticResource WindowFrame}">
        <Grid ClipToBounds="True">
            <Canvas IsHitTestVisible="False" Opacity="0.55">
                <Ellipse Width="520" Height="520" Canvas.Left="900" Canvas.Top="-340" Stroke="#1C4563" StrokeThickness="1" />
                <Ellipse Width="380" Height="380" Canvas.Left="970" Canvas.Top="-270" Stroke="#333D78" StrokeThickness="1" />
                <Ellipse Width="5" Height="5" Canvas.Left="1040" Canvas.Top="96" Fill="#65D8D0" />
                <Ellipse Width="3" Height="3" Canvas.Left="760" Canvas.Top="160" Fill="#8582BB" />
                <Ellipse Width="4" Height="4" Canvas.Left="1180" Canvas.Top="430" Fill="#716CF4" />
            </Canvas>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#E5080D15" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /><ColumnDefinition Width="46" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="/Assets/OrbitLauncher.png" Width="30" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="O R B I T" FontWeight="Bold" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Minecraft Launcher" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click"><TextBlock Text="&#xE921;" Style="{StaticResource FluentIcon}" /></Button>
                    <Button Grid.Column="3" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click"><TextBlock Text="&#xE922;" Style="{StaticResource FluentIcon}" /></Button>
                    <Button Grid.Column="4" Style="{StaticResource TitleBarButton}" Click="CloseButton_Click"><TextBlock Text="&#xE8BB;" Style="{StaticResource FluentIcon}" /></Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#EC090F19" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,0">
                        <Grid Margin="13,18,13,14">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="НАВИГАЦИЯ" Style="{StaticResource EyebrowText}" Margin="12,0,0,10" />
                            <StackPanel Grid.Row="1">
                                <RadioButton x:Name="LibraryNav" GroupName="Nav" IsChecked="True" Style="{StaticResource NavButton}" Checked="Navigation_Checked" Tag="Library">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource FluentIcon}" Width="31" /><TextBlock Text="Библиотека" VerticalAlignment="Center" /></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ModsNav" GroupName="Nav" Style="{StaticResource NavButton}" Checked="Navigation_Checked" Tag="Mods">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74C;" Style="{StaticResource FluentIcon}" Width="31" /><TextBlock Text="Моды" VerticalAlignment="Center" /></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SettingsNav" GroupName="Nav" Style="{StaticResource NavButton}" Checked="Navigation_Checked" Tag="Settings">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}" Width="31" /><TextBlock Text="Настройки" VerticalAlignment="Center" /></StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <Border Grid.Row="2" Style="{StaticResource SubtleCard}" Padding="11">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /></Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#17283D" BorderBrush="#30455F" BorderThickness="1" ClipToBounds="True">
                                            <Grid RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                <TextBlock x:Name="AccountFallbackGlyph" Text="&#xE77B;" Style="{StaticResource FluentIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryLightBrush}" />
                                                <Image x:Name="AccountFaceImage" Stretch="Fill" /><Image x:Name="AccountOverlayImage" Stretch="Fill" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="AccountNameText" Text="Без аккаунта" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="AccountModeText" Text="Аккаунт не подключён" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <Ellipse Grid.Column="2" x:Name="AccountStatusDot" Width="7" Height="7" Fill="#506078" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Button x:Name="GateLoginButton" Content="Войти в Microsoft" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,10,0,0" Click="MicrosoftLoginButton_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid x:Name="LibraryPage" Margin="28,24,28,20">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Библиотека" Style="{StaticResource TitleText}" />
                                    <TextBlock Text="Ваши сборки Minecraft" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,9,0" Click="ImportButton_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" Style="{StaticResource FluentIcon}" Margin="0,0,8,0" /><TextBlock Text="Импорт" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButton}" Click="CreateInstanceButton_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Margin="0,0,8,0" /><TextBlock Text="Новая сборка" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,20,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="InstanceSearchBox" TextChanged="InstanceSearchBox_TextChanged" Padding="38,9,12,9" />
                                    <TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource MutedTextBrush}" Margin="13,0,0,0" HorizontalAlignment="Left" />
                                    <TextBlock Text="Поиск сборок" IsHitTestVisible="False" Margin="38,0,0,0" VerticalAlignment="Center" Foreground="#66758B">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=InstanceSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Grid.Column="2" x:Name="InstanceCountText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <ItemsControl ItemsSource="{Binding VisibleInstances}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:GameInstance}">
                                                <Border x:Name="InstanceCard" Width="246" Height="238" Margin="0,0,14,14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13"
                                                        MouseLeftButtonUp="InstanceCard_MouseLeftButtonUp">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Запустить" Click="ContextLaunch_Click" />
                                                            <MenuItem Header="Параметры" Click="ContextEdit_Click" />
                                                            <MenuItem Header="Изменить иконку" Click="ContextIcon_Click" />
                                                            <MenuItem Header="Переименовать" Click="ContextRename_Click" />
                                                            <MenuItem Header="Установить моды" Click="ContextMods_Click" />
                                                            <Separator />
                                                            <MenuItem Header="Создать копию" Click="ContextDuplicate_Click" />
                                                            <MenuItem Header="Экспортировать" Click="ContextExport_Click" />
                                                            <MenuItem Header="Открыть папку" Click="ContextFolder_Click" />
                                                            <Separator />
                                                            <MenuItem Header="Удалить" Foreground="{StaticResource DangerBrush}" Click="ContextDelete_Click" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid Margin="16">
                                                        <Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                        <Border CornerRadius="11" Background="#17243A" ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Text="&#xE7B8;" Style="{StaticResource FluentIcon}" FontSize="34" Foreground="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding IconPath, Converter={StaticResource InstanceIconConverter}, Mode=OneWay}" Stretch="UniformToFill" />
                                                                <Border VerticalAlignment="Bottom" Background="#B0070C13" Padding="9,6">
                                                                    <TextBlock Text="{Binding LoaderDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="#DDE5F2" TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="1,12,0,0" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="2" Text="{Binding GameVersion, StringFormat=Minecraft {0}}" Style="{StaticResource CaptionText}" Margin="1,3,0,0" />
                                                        <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                                            <TextBlock Text="{Binding ModCountText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                                            <Button HorizontalAlignment="Right" Width="36" Height="32" Padding="0" Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="LaunchCardButton_Click">
                                                                <TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" />
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="InstanceCard" Property="IsMouseOver" Value="True"><Setter TargetName="InstanceCard" Property="Background" Value="{StaticResource CardHoverBrush}" /><Setter TargetName="InstanceCard" Property="BorderBrush" Value="#455B78" /></Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel x:Name="EmptyInstancesPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                        <Border Width="76" Height="76" CornerRadius="22" Background="#132033" HorizontalAlignment="Center"><TextBlock Text="&#xE7B8;" Style="{StaticResource FluentIcon}" FontSize="30" Foreground="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <TextBlock Text="Библиотека пуста" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                                        <TextBlock Text="Создайте сборку или импортируйте готовую." Style="{StaticResource MutedText}" Margin="0,5,0,16" />
                                        <Button Content="Создать сборку" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="CreateInstanceButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <Border Grid.Row="3" x:Name="LaunchStatusBar" Visibility="Collapsed" Margin="0,12,0,0" Style="{StaticResource CardBorder}" Padding="13">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock x:Name="LaunchInstanceText" FontWeight="SemiBold" FontSize="12" /><TextBlock x:Name="LaunchStatusText" Style="{StaticResource CaptionText}" Margin="0,2,0,0" /></StackPanel>
                                    <ProgressBar Grid.Column="1" x:Name="LaunchProgressBar" Margin="14,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Отмена" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="CancelLaunchButton_Click" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="ModsPage" Margin="28,24,28,20" Visibility="Collapsed" AllowDrop="True" DragOver="ModsPage_DragOver" Drop="ModsPage_Drop">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Моды и контент" Style="{StaticResource TitleText}" />
                                    <TextBlock Text="Управляйте файлами сборки или устанавливайте новые из каталога" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox x:Name="ModsInstanceCombo" Width="240" ItemsSource="{Binding Instances}" DisplayMemberPath="Name" SelectionChanged="ModsInstanceCombo_SelectionChanged" />
                                    <Button AutomationProperties.AutomationId="OpenContentCatalog" Style="{StaticResource PrimaryButton}" Margin="9,0,0,0" Click="BrowseModsButton_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" Margin="0,0,8,0" /><TextBlock Text="Открыть каталог" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,12">
                                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0">
                                    <Grid><Border Width="38" Height="38" CornerRadius="10" Background="#172A43" HorizontalAlignment="Left"><TextBlock Text="&#xE74C;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="50,0,0,0"><TextBlock x:Name="ModsCountText" Text="0" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Моды" Style="{StaticResource CaptionText}" /></StackPanel></Grid>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="4,0">
                                    <Grid><Border Width="38" Height="38" CornerRadius="10" Background="#172A43" HorizontalAlignment="Left"><TextBlock Text="&#xE8B9;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="50,0,0,0"><TextBlock x:Name="ResourcePacksCountText" Text="0" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Ресурспаки" Style="{StaticResource CaptionText}" /></StackPanel></Grid>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="4,0">
                                    <Grid><Border Width="38" Height="38" CornerRadius="10" Background="#172A43" HorizontalAlignment="Left"><TextBlock Text="&#xE706;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="50,0,0,0"><TextBlock x:Name="ShadersCountText" Text="0" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Шейдеры" Style="{StaticResource CaptionText}" /></StackPanel></Grid>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="8,0,0,0">
                                    <Grid><Border Width="38" Height="38" CornerRadius="10" Background="#172A43" HorizontalAlignment="Left"><TextBlock Text="&#xE896;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="50,0,0,0"><TextBlock x:Name="DownloadedCountText" Text="0" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Скачанные наборы" Style="{StaticResource CaptionText}" /></StackPanel></Grid>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="170" /><ColumnDefinition Width="10" /><ColumnDefinition Width="145" /><ColumnDefinition Width="10" /><ColumnDefinition Width="155" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox x:Name="ContentSearchBox" TextChanged="ContentSearchBox_TextChanged" Padding="38,8,12,8" />
                                            <TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource MutedTextBrush}" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                            <TextBlock Text="Поиск установленных файлов" Foreground="#8795AA" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ContentSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </Grid>
                                        <ComboBox Grid.Column="2" x:Name="ContentFolderCombo" SelectionChanged="ContentFolderCombo_SelectionChanged"><ComboBoxItem Content="Моды" Tag="mods" IsSelected="True" /><ComboBoxItem Content="Ресурспаки" Tag="resourcepacks" /><ComboBoxItem Content="Шейдеры" Tag="shaderpacks" /><ComboBoxItem Content="Скачанные наборы" Tag="downloads" /></ComboBox>
                                        <ComboBox Grid.Column="4" x:Name="ContentStateCombo" SelectionChanged="ContentFilter_SelectionChanged"><ComboBoxItem Content="Любое состояние" Tag="all" IsSelected="True" /><ComboBoxItem Content="Только включённые" Tag="enabled" /><ComboBoxItem Content="Только отключённые" Tag="disabled" /></ComboBox>
                                        <ComboBox Grid.Column="6" x:Name="ContentSortCombo" SelectionChanged="ContentFilter_SelectionChanged"><ComboBoxItem Content="По названию" Tag="name" IsSelected="True" /><ComboBoxItem Content="По размеру" Tag="size" /><ComboBoxItem Content="По дате изменения" Tag="date" /></ComboBox>
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="10,0,0,0">
                                            <Button ToolTip="Открыть текущую папку" Style="{StaticResource SecondaryButton}" Padding="11,7" Click="OpenModsFolderButton_Click"><TextBlock Text="&#xE838;" Style="{StaticResource FluentIcon}" /></Button>
                                            <Button ToolTip="Обновить список" Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="7,0,0,0" Click="RefreshModsButton_Click"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" /></Button>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="2,11,2,0">
                                        <TextBlock x:Name="ModsSummaryText" Text="Выберите сборку" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="EnableAllContentButton" Content="Включить все" Style="{StaticResource LinkButton}" Click="EnableAllContent_Click" />
                                            <TextBlock Text=" · " Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                            <Button x:Name="DisableAllContentButton" Content="Отключить все" Style="{StaticResource LinkButton}" Click="DisableAllContent_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                                    <ItemsControl ItemsSource="{Binding InstalledMods}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:InstalledMod}">
                                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,9" Padding="14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Border Width="40" Height="40" CornerRadius="10" Background="#172A43"><TextBlock Text="{Binding IconGlyph, Mode=OneWay}" Style="{StaticResource FluentIcon}" FontSize="17" Foreground="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                        <StackPanel Grid.Column="1" Margin="11,0,15,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding LocalizedTypeText, Mode=OneWay}" Style="{StaticResource CaptionText}" /><TextBlock Text=" · " Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding StateText, Mode=OneWay}" Style="{StaticResource CaptionText}" /><TextBlock Text=" · " Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding SizeText, Mode=OneWay}" Style="{StaticResource CaptionText}" /><TextBlock Text=" · " Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding ModifiedText, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="{Binding ToggleActionText, Mode=OneWay}" Tag="{Binding}" Padding="12,6" Click="ToggleModButton_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding CanToggle}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                                            <Button ToolTip="Показать файл в папке" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="7,0,0,0" Click="ShowContentFileButton_Click"><TextBlock Text="&#xE838;" Style="{StaticResource FluentIcon}" /></Button>
                                                            <Button ToolTip="Удалить файл" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="7,0,0,0" Foreground="{StaticResource DangerBrush}" Click="DeleteModButton_Click"><TextBlock Text="&#xE74D;" Style="{StaticResource FluentIcon}" /></Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel x:Name="ModsEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="&#xE74C;" Style="{StaticResource FluentIcon}" FontSize="30" Foreground="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ModsEmptyTitle" Text="Здесь пока пусто" FontSize="16" FontWeight="SemiBold" Margin="0,11,0,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="Откройте каталог или перетащите подходящие файлы в это окно." Style="{StaticResource MutedText}" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Row="1" BorderBrush="#315071" BorderThickness="1" CornerRadius="9" Background="#101925" Padding="11,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE898;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,8,0" /><TextBlock Text="Перетащите сюда JAR, ZIP или MRPACK — файл попадёт в выбранный раздел" Style="{StaticResource CaptionText}" /></StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid x:Name="SettingsPage" Margin="28,24,28,20" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="Настройки" Style="{StaticResource TitleText}" /><TextBlock Text="Параметры лаунчера и аккаунта" Style="{StaticResource MutedText}" Margin="0,3,0,0" /></StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820" HorizontalAlignment="Left">
                                <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Аккаунт Minecraft" Style="{StaticResource SectionTitle}" /><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="12" Background="#17283D" ClipToBounds="True"><Grid RenderOptions.BitmapScalingMode="NearestNeighbor"><TextBlock Text="&#xE77B;" Style="{StaticResource FluentIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryLightBrush}" /><Image x:Name="SettingsFaceImage" Stretch="Fill" /><Image x:Name="SettingsOverlayImage" Stretch="Fill" /></Grid></Border><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="SettingsAccountNameText" Text="Без аккаунта" FontWeight="SemiBold" /><TextBlock x:Name="SettingsAccountHintText" Text="Вход нужен только для запуска игры" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SettingsLoginButton" Content="Войти в Microsoft" Style="{StaticResource PrimaryButton}" Click="MicrosoftLoginButton_Click" /><Button x:Name="SignOutButton" Content="Выйти" Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" Visibility="Collapsed" Click="SignOutButton_Click" /></StackPanel></Grid></StackPanel></Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Офлайн-режим" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Создаёт локальную игровую сессию без Microsoft. Серверы с online-mode и Realms в этом режиме недоступны." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14" />
                                        <CheckBox x:Name="OfflineModeCheck" Style="{StaticResource SwitchToggle}" Checked="OfflineModeCheck_Changed" Unchecked="OfflineModeCheck_Changed">
                                            <StackPanel><TextBlock Text="Разрешить запуск без Microsoft-аккаунта" FontWeight="SemiBold" /><TextBlock Text="При выключении для запуска снова потребуется лицензионная сессия" Style="{StaticResource CaptionText}" Margin="0,3,12,0" /></StackPanel>
                                        </CheckBox>
                                        <StackPanel x:Name="OfflinePlayerNamePanel" Margin="0,15,0,0">
                                            <TextBlock Text="Имя офлайн-игрока" Style="{StaticResource DialogLabel}" />
                                            <TextBox x:Name="OfflinePlayerNameBox" MaxLength="16" LostFocus="OfflinePlayerNameBox_LostFocus" />
                                            <TextBlock Text="От 3 до 16 символов: латинские буквы, цифры и подчёркивание." Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Память по умолчанию" Style="{StaticResource SectionTitle}" /><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Минимум, МБ" Style="{StaticResource DialogLabel}" /><TextBox x:Name="DefaultMinRamBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Максимум, МБ" Style="{StaticResource DialogLabel}" /><TextBox x:Name="DefaultMaxRamBox" /></StackPanel></Grid></StackPanel></Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Поведение" Style="{StaticResource SectionTitle}" /><CheckBox x:Name="ShowSnapshotsCheck" Content="Показывать снапшоты Minecraft" Margin="0,16,0,0" /><CheckBox x:Name="CloseOnLaunchCheck" Content="Сворачивать лаунчер после запуска игры" Margin="0,12,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Язык" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Язык интерфейса" Style="{StaticResource DialogLabel}" Margin="0,14,0,6" />
                                        <ComboBox x:Name="LanguageCombo" Width="240" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Русский" Tag="ru" />
                                            <ComboBoxItem Content="Английский" Tag="en" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Моды и зависимости" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Настройте, какие зависимости устанавливать вместе с выбранным модом." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14" />
                                        <CheckBox x:Name="AutoInstallFabricApiCheck" Style="{StaticResource SwitchToggle}" Margin="0,0,0,16">
                                            <StackPanel><TextBlock Text="Устанавливать Fabric API в новые Fabric-сборки" FontWeight="SemiBold" /><TextBlock Text="Совместимая версия будет скачана с Modrinth сразу после создания сборки" Style="{StaticResource CaptionText}" Margin="0,3,12,0" /></StackPanel>
                                        </CheckBox>
                                        <TextBlock Text="Автоскачивание зависимых модов" Style="{StaticResource DialogLabel}" />
                                        <ComboBox x:Name="DependencyDownloadModeCombo" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Все" Tag="all" />
                                            <ComboBoxItem Content="Только обязательные" Tag="required" IsSelected="True" />
                                            <ComboBoxItem Content="Никакие" Tag="none" />
                                        </ComboBox>
                                        <TextBlock Text="Режим «Все» включает обязательные и необязательные зависимости. Несовместимые зависимости никогда не устанавливаются." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                                <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="SaveSettingsButton_Click" />
                            </StackPanel></ScrollViewer>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
