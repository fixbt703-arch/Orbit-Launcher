<?xml version="1.0" encoding="utf-8"?>
<Window Style="{StaticResource {x:Type Window}}" x:Class="OrbitLauncher.Dialogs.EditInstanceDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Параметры сборки" Width="620" Height="650" MinHeight="610" ResizeMode="CanResize" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="#00FFFFFF" xmlns:dialogs="clr-namespace:OrbitLauncher.Dialogs;assembly=OrbitLauncher">
  <Border Style="{StaticResource WindowFrame}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
        <RowDefinition Height="70" />
      </Grid.RowDefinitions>
      <Grid Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" Foreground="{DynamicResource PrimaryLightBrush}" Width="18" Height="18" />
          <TextBlock Text="Параметры сборки" Margin="11,0,0,0" FontWeight="SemiBold" FontSize="14" />
        </StackPanel>
        <Button HorizontalAlignment="Right" Width="48" Style="{StaticResource TitleBarButton}" Click="Cancel_Click" ToolTip="Закрыть">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" />
        </Button>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22">
          <TextBlock Text="Основное" Style="{StaticResource SectionTitle}" />
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Название" Style="{StaticResource DialogLabel}" />
              <TextBox Name="NameBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Версия Minecraft" Style="{StaticResource DialogLabel}" />
              <TextBox Name="GameVersionBox" TextChanged="GameVersionBox_TextChanged" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Загрузчик" Style="{StaticResource DialogLabel}" />
              <ComboBox Name="LoaderBox" SelectionChanged="LoaderBox_SelectionChanged">
                <ComboBoxItem Content="Vanilla" />
                <ComboBoxItem Content="Fabric" />
                <ComboBoxItem Content="Forge" />
                <ComboBoxItem Content="NeoForge" />
                <ComboBoxItem Content="Quilt" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Версия загрузчика" Style="{StaticResource DialogLabel}" />
              <ComboBox Name="LoaderVersionBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" ItemsSource="{Binding LoaderVersions}" />
              <TextBlock Name="LoaderVersionStatusText" Style="{StaticResource CaptionText}" Margin="2,5,0,0" />
            </StackPanel>
          </Grid>
          <CheckBox Name="OrbitClientCheck" Margin="0,16,0,0" Checked="OrbitClientCheck_Changed" Unchecked="OrbitClientCheck_Changed">
            <StackPanel>
              <TextBlock Text="Orbit Client" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryLightBrush}" />
              <TextBlock Text="PvP HUD, меню на Right Shift и оптимизация" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
            </StackPanel>
          </CheckBox>
          <CheckBox Name="OrbitConnectCheck" Margin="0,16,0,0">
            <StackPanel><TextBlock Text="Orbit Connect" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryLightBrush}"/>
              <TextBlock Text="Игра с друзьями в своём мире · без аренды сервера" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
          </CheckBox>
          <Separator Margin="0,24" />
          <TextBlock Text="Производительность" Style="{StaticResource SectionTitle}" />
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Минимум памяти, МБ" Style="{StaticResource DialogLabel}" />
              <TextBox Name="MinRamBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Максимум памяти, МБ" Style="{StaticResource DialogLabel}" />
              <TextBox Name="MaxRamBox" />
            </StackPanel>
          </Grid>
          <TextBlock Text="Путь к Java (необязательно)" Style="{StaticResource DialogLabel}" Margin="0,14,0,0" />
          <TextBox Name="JavaPathBox" />
          <Expander Header="Дополнительно" Margin="0,20,0,0">
            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="ID профиля запуска" Style="{StaticResource DialogLabel}" />
              <TextBox Name="LaunchVersionBox" />
              <TextBlock Text="Оставьте пустым для автоматической установки выбранного загрузчика." Style="{StaticResource CaptionText}" Margin="2,5,0,0" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Cancel_Click" />
          <Button Name="SaveButton" Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
