<Window x:Class="OrbitLauncher.Dialogs.ElyLoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Вход в Ely.by" Width="460" Height="465" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="Transparent" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <Style TargetType="PasswordBox">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Field" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.55"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Style="{StaticResource WindowFrame}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
      <Grid Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="Header_Drag">
        <TextBlock Text="Вход в Ely.by" FontWeight="SemiBold" Margin="22,0,0,0" VerticalAlignment="Center"/>
        <Button Content="×" Width="48" HorizontalAlignment="Right" Style="{StaticResource TitleBarButton}" Click="Close_Click" IsCancel="True" AutomationProperties.Name="Закрыть"/>
      </Grid>
      <StackPanel Margin="26,20,26,10" Grid.Row="1">
        <TextBlock Text="Ваш аккаунт и скины" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Войдите в Ely.by, чтобы использовать свой ник и скин в игре." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,6,0,16"/>
        <TextBlock Text="Ник или почта Ely.by" Style="{StaticResource DialogLabel}"/>
        <TextBox x:Name="LoginBox" MaxLength="254" AutomationProperties.Name="Ник или почта Ely.by"/>
        <TextBlock Text="Пароль" Style="{StaticResource DialogLabel}" Margin="0,12,0,6"/>
        <PasswordBox x:Name="PasswordInput" Height="38" Padding="10,6" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Пароль Ely.by"/>
        <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,10,0,0">
          <TextBlock Text="Код из приложения аутентификации" Style="{StaticResource DialogLabel}"/>
          <TextBox x:Name="CodeBox" MaxLength="6" AutomationProperties.Name="Код подтверждения Ely.by"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
      <Grid Grid.Row="2" Margin="26,0,26,18">
        <Button Content="Создать аккаунт" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Click="Register_Click"/>
        <Button x:Name="LoginButton" Content="Войти" HorizontalAlignment="Right" MinWidth="104" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Login_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
