<Window x:Class="OrbitLauncher.Dialogs.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Обновление Orbit Launcher"
        Width="600" Height="510" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent">
  <Border Style="{StaticResource WindowFrame}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="24,18,16,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Source="/OrbitLauncher;component/Assets/orbitlauncher.png" Width="26" Height="26" Margin="0,0,10,0"/>
        <TextBlock Text="Orbit Launcher" FontWeight="SemiBold" VerticalAlignment="Center" Grid.Column="1"/>
        <Button Name="CloseButton" Content="×" Grid.Column="2" Width="32" Height="32" Style="{StaticResource QuietButton}"
                Padding="0" FontSize="20" Click="Close_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть"/>
      </Grid>
      <Grid Grid.Row="1" Margin="24,22,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Name="HeadingText" Text="Доступно обновление" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Name="VersionText" Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,8,0,20"/>
        <TextBlock Name="NotesLabel" Text="Что нового" Grid.Row="2" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="14,10">
          <ScrollViewer Name="NotesScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Name="NotesText" TextWrapping="Wrap" Style="{StaticResource CaptionText}"/>
          </ScrollViewer>
        </Border>
        <StackPanel Name="ProgressPanel" Grid.Row="4" Margin="0,16,0,0" Visibility="Collapsed">
          <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Name="ProgressLabel" Style="{StaticResource CaptionText}"/>
            <TextBlock Name="ProgressValue" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource CaptionText}"/>
          </Grid>
          <ProgressBar Name="DownloadProgress" Minimum="0" Maximum="100" Height="6" AutomationProperties.Name="Загрузка обновления"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" Style="{StaticResource DialogFooter}" Padding="24,16">
        <StackPanel>
          <TextBlock Name="HintText" Text="После установки лаунчер откроется снова. Сборки и аккаунты сохранятся."
                     Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Name="ReleasePageButton" Content="На GitHub" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                    Click="ReleasePage_Click" Padding="10,8"/>
            <Button Name="LaterButton" Content="Позже" Grid.Column="1" Style="{StaticResource SecondaryButton}" MinWidth="84"
                    Margin="12,0,8,0" Click="Later_Click"/>
            <Button Name="UpdateButton" Content="Обновить сейчас" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                    MinWidth="160" Click="Update_Click"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
