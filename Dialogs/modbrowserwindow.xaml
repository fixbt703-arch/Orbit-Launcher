    <DataTemplate x:Key="CatalogSourceTemplate" DataType="{x:Type models:ModSearchOption}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False">
          <Path.Style>
            <Style TargetType="Path">
              <Setter Property="Data" Value="{StaticResource ModrinthLogoGeometry}" />
              <Setter Property="Fill" Value="#1BD96A" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="curseforge">
                  <Setter Property="Data" Value="{StaticResource CurseForgeLogoGeometry}" />
                  <Setter Property="Fill" Value="#F16436" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Path.Style>
        </Path>
        <TextBlock Text="{Binding LocalizedDisplayName}" Margin="9,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Border Style="{StaticResource WindowFrame}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="76" />
        <RowDefinition Height="*" />
        <RowDefinition Height="48" />
      </Grid.RowDefinitions>
      <Grid Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" Foreground="{DynamicResource PrimaryLightBrush}" Width="18" Height="18" />
          <TextBlock Text="Каталог контента" FontWeight="SemiBold" Margin="11,0,0,0" />
          <TextBlock Text=" · " Style="{StaticResource MutedText}" />
          <TextBlock Name="InstanceText" Style="{StaticResource MutedText}" />
        </StackPanel>
        <Button HorizontalAlignment="Right" Width="48" Style="{StaticResource TitleBarButton}" Click="Close_Click" ToolTip="Закрыть">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" />
        </Button>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox Name="CatalogSourceCombo" ItemTemplate="{StaticResource CatalogSourceTemplate}" AutomationProperties.Name="Источник каталога" SelectedValuePath="Id" ItemsSource="{Binding CatalogSources}" SelectionChanged="CatalogSource_SelectionChanged" />
          <Grid Column="2">
            <TextBox Name="SearchBox" AutomationProperties.AutomationId="CatalogSearchBox" Padding="40,10,14,10" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
            <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" Foreground="{DynamicResource MutedTextBrush}" Margin="14,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
            <TextBlock Text="Название, автор или ключевые слова" Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" Margin="40,0,0,0" VerticalAlignment="Center">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Value="" Binding="{Binding Text, ElementName=SearchBox}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </Grid>
          <Button Grid.Column="4" Content="Найти" Style="{StaticResource PrimaryButton}" Padding="25,9" Click="SearchButton_Click" />
        </Grid>
      </Border>
      <Grid Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="238" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Тип контента" Style="{StaticResource CaptionText}" Margin="2,0,0,6" />
              <ComboBox Name="ProjectTypeCombo" AutomationProperties.AutomationId="ProjectTypeFilter" DisplayMemberPath="LocalizedDisplayName" SelectedValuePath="Id" ItemsSource="{Binding ProjectTypes}" SelectionChanged="ProjectType_SelectionChanged" />
              <TextBlock Text="Версия Minecraft" Style="{StaticResource CaptionText}" Margin="2,16,0,6" />
              <ComboBox Name="GameVersionCombo" DisplayMemberPath="LocalizedDisplayName" SelectedValuePath="Id" ItemsSource="{Binding GameVersions}" SelectionChanged="Filter_SelectionChanged" />
              <TextBlock Text="Загрузчик" Style="{StaticResource CaptionText}" Margin="2,16,0,6" />
              <ComboBox Name="LoaderCombo" DisplayMemberPath="LocalizedDisplayName" SelectedValuePath="Id" ItemsSource="{Binding Loaders}" SelectionChanged="Filter_SelectionChanged" />
              <TextBlock Text="Категория" Style="{StaticResource CaptionText}" Margin="2,16,0,6" />
              <ComboBox Name="CategoryCombo" DisplayMemberPath="LocalizedDisplayName" SelectedValuePath="Id" ItemsSource="{Binding Categories}" SelectionChanged="Filter_SelectionChanged" />
              <TextBlock Text="Поддержка стороны" Style="{StaticResource CaptionText}" Margin="2,16,0,6" />
              <ComboBox Name="EnvironmentCombo" DisplayMemberPath="LocalizedDisplayName" SelectedValuePath="Id" ItemsSource="{Binding EnvironmentOptions}" SelectionChanged="Filter_SelectionChanged" />
              <TextBlock Text="Сортировка" Style="{StaticResource CaptionText}" Margin="2,16,0,6" />
              <ComboBox Name="SortCombo" DisplayMemberPath="LocalizedDisplayName" SelectedValuePath="Id" ItemsSource="{Binding SortOptions}" SelectionChanged="Filter_SelectionChanged" />
              <Button Content="Сбросить фильтры" Style="{StaticResource LinkButton}" Margin="0,18,0,0" HorizontalAlignment="Left" Click="ResetFilters_Click" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Grid Name="ResultsPane" Column="1">
          <ScrollViewer Name="ResultsScroll" VerticalScrollBarVisibility="Auto" Margin="16,14,10,12" ScrollChanged="ResultsScroll_ScrollChanged">
            <StackPanel>
              <ItemsControl Name="ResultsItems" ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type models:ModSearchResult}">
                    <Border Style="{StaticResource InstanceCardSurface}" Margin="0,0,6,12" Padding="16" CornerRadius="10" Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="ProjectCard_MouseLeftButtonUp">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="116" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="100" Height="100" CornerRadius="10" Background="{DynamicResource ControlBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <Grid>
  <ContentControl Content="&#xF2C9;" Width="32" Height="32" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
    <ContentControl.Style><Style TargetType="ContentControl" BasedOn="{StaticResource SmoothActionIcon}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ContentControl.Style>
  </ContentControl>
<Image Width="100" Height="100" Stretch="UniformToFill" Source="{Binding Icon}">
                            <UIElement.Clip>
                              <RectangleGeometry Rect="0,0,100,100" RadiusX="10" RadiusY="10" />
                            </UIElement.Clip>
                          </Image></Grid>
                        </Border>
                        <Grid Column="1" MinHeight="100" VerticalAlignment="Center">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>
                          <TextBlock FontSize="16" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Top">
                            <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" />
                            <Run FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding AuthorByline, Mode=OneWay}" />
                          </TextBlock>
                          <StackPanel Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Right" Margin="12,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                              <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" Width="14" Height="14" Foreground="{DynamicResource PrimaryLightBrush}" />
                              <TextBlock FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="Загрузки" Text="{Binding CompactDownloads}" />
                              <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                      <DataTrigger Value="False" Binding="{Binding HasFollowers}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                                <ContentControl Content="{StaticResource SmoothHeartGeometry}" Style="{StaticResource SmoothActionIcon}" Width="14" Height="14" Foreground="{DynamicResource PrimaryLightBrush}" />
                                <TextBlock FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="Подписчики" Text="{Binding CompactFollowers}" />
                              </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                              <FrameworkElement.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <DataTrigger Value="False" Binding="{Binding HasUpdatedDate}">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                              <ContentControl Content="{StaticResource SmoothClockGeometry}" Style="{StaticResource SmoothActionIcon}" Width="14" Height="14" Foreground="{DynamicResource MutedTextBrush}" />
                              <TextBlock Style="{StaticResource CaptionText}" Margin="5,0,0,0" ToolTip="Дата обновления" Text="{Binding UpdatedShortText}" />
                            </StackPanel>
                          </StackPanel>
                          <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,5,10,0" Text="{Binding Description}" />
                          <Grid Row="2" ColumnSpan="2" Margin="0,14,0,0" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Chips}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CatalogChip}">
                                  <Border CornerRadius="11" Padding="8,4" Margin="0,0,6,6">
                                    <FrameworkElement.Style>
                                      <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                          <DataTrigger Value="True" Binding="{Binding IsLoader}">
                                            <Setter Property="Background" Value="{DynamicResource SoftAccentBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </FrameworkElement.Style>
                                    <TextBlock Foreground="{DynamicResource PrimaryLightBrush}" FontSize="12" Text="{Binding Text}" />
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="9,0,0,5" VerticalAlignment="Bottom" Content="{Binding ActionText}" IsEnabled="{Binding CanInstall}" Tag="{Binding}" Click="InstallButton_Click" />
                          </Grid>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Name="LoadMoreButton" Content="Показать ещё" Style="{StaticResource SecondaryButton}" Margin="0,4,6,12" HorizontalAlignment="Center" Visibility="Collapsed" Click="LoadMoreButton_Click" />
            </StackPanel>
          </ScrollViewer>
          <StackPanel Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Width="170" />
            <TextBlock Text="Загружаем каталог…" Style="{StaticResource MutedText}" Margin="0,14,0,0" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" Foreground="{DynamicResource PrimaryLightBrush}" HorizontalAlignment="Center" Width="30" Height="30" />
            <TextBlock Name="EmptyTitleText" Text="Ничего не найдено" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center" />
            <TextBlock Name="EmptyHintText" Text="Измените запрос или фильтры." Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" />
          </StackPanel>
        </Grid>
        <Border Name="DetailPanel" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="56" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="18,0,10,0">
              <TextBlock Text="О проекте" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <Button Name="BackToCatalogButton" HorizontalAlignment="Left" Style="{StaticResource CompactQuietButton}" ToolTip="К каталогу" Click="CloseDetailsButton_Click"><StackPanel Orientation="Horizontal"><ContentControl Content="&#xEA19;" Style="{StaticResource SmoothActionIcon}" Margin="0,0,8,0" /><TextBlock Text="К каталогу" VerticalAlignment="Center" /></StackPanel></Button>
            </Grid>
            <Grid Row="1">
              <StackPanel Name="DetailLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="150" />
                <TextBlock Text="Загружаем описание…" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
              </StackPanel>
              <ScrollViewer Name="DetailContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="18,0,14,18">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="66" Height="66" CornerRadius="14" Background="{DynamicResource ControlBrush}">
                      <Image Name="DetailIcon" Width="66" Height="66" Stretch="UniformToFill">
                        <UIElement.Clip>
                          <RectangleGeometry Rect="0,0,66,66" RadiusX="14" RadiusY="14" />
                        </UIElement.Clip>
                      </Image>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                      <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,0" Text="{Binding AuthorText}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0" Text="{Binding Summary}" />
                  <WrapPanel Margin="0,14,0,0">
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,7,7">
                      <TextBlock Style="{StaticResource CaptionText}" Text="{Binding StatsText}" />
                    </Border>
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,7,7">
                      <TextBlock Style="{StaticResource CaptionText}" Text="{Binding UpdatedText}" />
                    </Border>
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,7,7">
                      <TextBlock Style="{StaticResource CaptionText}" Text="{Binding LicenseText}" />
                    </Border>
                  </WrapPanel>
                  <TextBlock Foreground="{DynamicResource PrimaryLightBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding CompatibilityText}" />
                  <WrapPanel Margin="0,17,0,0">
                    <Button Name="DetailInstallButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Content="{Binding SearchResult.ActionText}" IsEnabled="{Binding SearchResult.CanInstall}" Tag="{Binding SearchResult}" Click="InstallButton_Click" />
                    <Button Content="Выбрать версию" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="ChooseVersion_Click" />
                    <Button Content="Страница проекта" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="OpenProjectWebsite_Click" />
                    <Button Name="OpenDownloadFolderButton" Content="Открыть папку" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Margin="0,0,8,8" Click="OpenDownloadFolder_Click" />
                  </WrapPanel>
                  <StackPanel Margin="0,15,0,0">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Value="0" Binding="{Binding Gallery.Count}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                    <TextBlock Text="Галерея" FontSize="15" FontWeight="SemiBold" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,9,0,0">
                      <ItemsControl ItemsSource="{Binding Gallery}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Width="220" Height="125" CornerRadius="10" Background="{DynamicResource ControlBrush}" Margin="0,0,10,6" ClipToBounds="True" Cursor="Hand" ToolTip="{Binding Title}" MouseLeftButtonUp="GalleryImage_Click">
                              <Image Stretch="UniformToFill" Source="{Binding Image}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                  <StackPanel Margin="0,17,0,0">
                    <TextBlock Text="Зависимости" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding DependencyStatusText}" />
                    <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Dependencies}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                            <Grid>
                              <TextBlock Text="{Binding Title}" />
                              <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Right" Text="{Binding TypeDisplay}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock Text="Описание" FontSize="15" FontWeight="SemiBold" Margin="0,17,0,0" />
                  <StackPanel Name="DescriptionHost" Margin="0,8,0,0" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0">
        <Grid>
          <TextBlock Name="StatusText" Text="Загрузка каталога…" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
          <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Padding="14,6" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
