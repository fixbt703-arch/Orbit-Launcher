<?xml version="1.0" encoding="utf-8"?>
<Window Style="{StaticResource {x:Type Window}}" x:Class="OrbitLauncher.Dialogs.GalleryViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Галерея" WindowState="Maximized" WindowStyle="None" Background="{DynamicResource OverlayBrush}" xmlns:dialogs="clr-namespace:OrbitLauncher.Dialogs;assembly=OrbitLauncher" xmlns:utilities="clr-namespace:OrbitLauncher.Utilities" KeyDown="Viewer_KeyDown">
  <Grid>
    <ScrollViewer Name="ImageScroll" utilities:SmoothScroll.Enabled="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Viewport_SizeChanged" MouseWheel="ImageScroll_MouseWheel">
      <Grid MinWidth="{Binding ElementName=ImageScroll, Path=ViewportWidth}" MinHeight="{Binding ElementName=ImageScroll, Path=ViewportHeight}">
        <Image Name="LargeImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
      </Grid>
    </ScrollViewer>
    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" Background="{DynamicResource OverlayBrush}" CornerRadius="14" Padding="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <Button Width="42" Height="34" Style="{StaticResource GalleryToolbarButton}" ToolTip="Предыдущее изображение" Click="Previous_Click">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" />
        </Button>
        <TextBlock Name="PositionText" Text="1 / 1" Width="66" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
        <Button Width="42" Height="34" Style="{StaticResource GalleryToolbarButton}" ToolTip="Следующее изображение" Click="Next_Click">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" />
        </Button>
        <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="7,0" VerticalAlignment="Center" />
        <Button Width="38" Height="34" Style="{StaticResource GalleryToolbarButton}" ToolTip="Уменьшить" Click="ZoomOut_Click">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" />
        </Button>
        <TextBlock Name="ZoomText" Text="100%" Width="58" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
        <Button Width="38" Height="34" Style="{StaticResource GalleryToolbarButton}" ToolTip="Увеличить" Click="ZoomIn_Click">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" />
        </Button>
        <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="7,0" VerticalAlignment="Center" />
        <Button Width="38" Height="34" Style="{StaticResource GalleryToolbarButton}" ToolTip="Закрыть (Esc)" Click="Close_Click">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" />
        </Button>
      </StackPanel>
    </Border>
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20" Background="{DynamicResource OverlayBrush}" CornerRadius="8" Padding="12,7">
      <TextBlock Name="CaptionText" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="920" />
    </Border>
  </Grid>
</Window>