<Window x:Class="OrbitLauncher.Dialogs.NewSkinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый скин" Width="640" Height="500" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner" Background="Transparent">
    <Window.Resources>
        <Style x:Key="SkinModelChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="#101A29" BorderBrush="#2B405C" BorderThickness="1" CornerRadius="11" Padding="14,12">
                            <Grid><ContentPresenter /><Border x:Name="Dot" Width="18" Height="18" CornerRadius="9" BorderBrush="#61718A" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse x:Name="Fill" Margin="3" Fill="{StaticResource PrimaryBrush}" Visibility="Collapsed" /></Border></Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryLightBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryLightBrush}" /><Setter TargetName="Card" Property="Background" Value="#19243B" /><Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource PrimaryLightBrush}" /><Setter TargetName="Fill" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource WindowFrame}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="76" /></Grid.RowDefinitions>
            <Grid Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center"><TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource PrimaryLightBrush}" FontSize="18" /><TextBlock Text="Новый скин" Margin="11,0,0,0" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" /></StackPanel>
                <Button HorizontalAlignment="Right" Width="50" Style="{StaticResource TitleBarButton}" Click="Cancel_Click"><TextBlock Text="&#xE8BB;" Style="{StaticResource FluentIcon}" /></Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="28,22">
                <TextBlock Text="Добавьте скин в библиотеку" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Укажите название, PNG-файл и модель персонажа." Style="{StaticResource MutedText}" Margin="0,5,0,20" />

                <TextBlock Text="Название скина" Style="{StaticResource DialogLabel}" />
                <TextBox x:Name="NameBox" MaxLength="28" />

                <TextBlock Text="Файл скина" Style="{StaticResource DialogLabel}" Margin="0,16,0,6" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="FileBox" IsReadOnly="True" Text="Файл не выбран" /><Button Grid.Column="2" Content="Выбрать файл" Style="{StaticResource SecondaryButton}" Click="Browse_Click" /></Grid>
                <TextBlock Text="Поддерживается PNG размером 64×64 пикселя." Style="{StaticResource CaptionText}" Margin="2,5,0,0" />

                <TextBlock Text="Модель скина" Style="{StaticResource DialogLabel}" Margin="0,17,0,6" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <RadioButton x:Name="WideModelRadio" GroupName="SkinModel" IsChecked="True" Tag="classic" Style="{StaticResource SkinModelChoice}"><StackPanel><TextBlock Text="Широкий" FontWeight="SemiBold" /><TextBlock Text="Классические руки Steve" Style="{StaticResource CaptionText}" Margin="0,3,28,0" /></StackPanel></RadioButton>
                    <RadioButton x:Name="SlimModelRadio" Grid.Column="1" GroupName="SkinModel" Tag="slim" Style="{StaticResource SkinModelChoice}" Margin="0"><StackPanel><TextBlock Text="Стройный" FontWeight="SemiBold" /><TextBlock Text="Тонкие руки Alex" Style="{StaticResource CaptionText}" Margin="0,3,28,0" /></StackPanel></RadioButton>
                </Grid>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Отменить" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button Content="Сохранить" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Save_Click" />
                    <Button Content="Сохранить и применить" Style="{StaticResource PrimaryButton}" Click="SaveAndApply_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
