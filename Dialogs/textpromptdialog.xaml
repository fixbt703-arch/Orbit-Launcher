<?xml version="1.0" encoding="utf-8"?>
<Window Style="{StaticResource {x:Type Window}}" x:Class="OrbitLauncher.Dialogs.TextPromptDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="450" Height="250" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="#00FFFFFF" xmlns:dialogs="clr-namespace:OrbitLauncher.Dialogs;assembly=OrbitLauncher">
  <Border Style="{StaticResource WindowFrame}">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <ContentControl Content="諒" Style="{StaticResource SmoothActionIcon}" Foreground="{DynamicResource PrimaryLightBrush}" Width="18" Height="18" />
        <TextBlock Name="TitleText" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
      </StackPanel>
      <TextBlock Name="LabelText" Grid.Row="1" Style="{StaticResource DialogLabel}" Margin="0,22,0,6" />
      <TextBox Name="ValueBox" Grid.Row="2" />
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="0,0,9,0" Click="Cancel_Click" />
        <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>