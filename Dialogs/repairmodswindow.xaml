<?xml version="1.0" encoding="utf-8"?>
<Window Style="{StaticResource {x:Type Window}}" x:Class="OrbitLauncher.Dialogs.RepairModsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Исправление модов" Width="780" Height="650" MinWidth="650" MinHeight="520" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="#00FFFFFF" xmlns:dialogs="clr-namespace:OrbitLauncher.Dialogs;assembly=OrbitLauncher">
  <Border Style="{StaticResource WindowFrame}">
    <Grid Margin="26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel>
          <TextBlock Text="Исправление модов" FontSize="25" FontWeight="SemiBold" />
          <TextBlock Name="InstanceText" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
        </StackPanel>
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="34" Style="{StaticResource TitleBarButton}" ToolTip="Закрыть или остановить" Click="Close_Click">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" />
        </Button>
      </Grid>
      <Border Grid.Row="1" Margin="0,22,0,0" Padding="16" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource SoftAccentBrush}">
            <ContentControl Content="{StaticResource SmoothRepairGeometry}" Style="{StaticResource SmoothActionIcon}" Width="20" Height="20" Foreground="{DynamicResource PrimaryLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Name="PhaseText" Text="Подготовка к проверке…" FontWeight="SemiBold" />
            <TextBlock Text="Проверяем версии игры, загрузчик, Java и зависимости модов. Замены сохраняют резервные копии." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Row="2" Margin="0,17,0,16">
        <Grid>
          <TextBlock Text="Ход проверки" FontWeight="SemiBold" />
          <TextBlock Name="ProgressText" Text="0 / 0" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
        </Grid>
        <ProgressBar Name="RepairProgressBar" Minimum="0" Maximum="100" Height="8" Margin="0,9,0,0" />
      </StackPanel>
      <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Updates}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="12,10" Margin="0,0,0,5" Background="{DynamicResource CardHoverBrush}" CornerRadius="9">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl VerticalAlignment="Center" Content="{Binding Glyph}"><ContentControl.Style><Style TargetType="ContentControl" BasedOn="{StaticResource SmoothActionIcon}"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="Muted"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
                    <StackPanel Grid.Column="1">
                      <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding File}" />
                      <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0" Text="{Binding Message}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <Grid Row="4" Margin="0,17,0,0">
        <TextBlock Name="SummaryText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,180,0" TextWrapping="Wrap" />
        <Button Name="ActionButton" Content="Остановить" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="Close_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>