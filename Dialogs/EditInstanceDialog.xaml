<Window x:Class="OrbitLauncher.Dialogs.EditInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры сборки" Width="620" Height="650" MinHeight="610"
        ResizeMode="CanResize" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="Transparent">
    <Border Style="{StaticResource WindowFrame}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="70" /></Grid.RowDefinitions>
            <Grid Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource PrimaryLightBrush}" FontSize="18" />
                    <TextBlock Text="Параметры сборки" Margin="11,0,0,0" FontWeight="SemiBold" FontSize="14" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="48" Style="{StaticResource TitleBarButton}" Click="Cancel_Click"><TextBlock Text="&#xE8BB;" Style="{StaticResource FluentIcon}" /></Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22">
                    <TextBlock Text="Основное" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Название" Style="{StaticResource DialogLabel}" /><TextBox x:Name="NameBox" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Версия Minecraft" Style="{StaticResource DialogLabel}" /><TextBox x:Name="GameVersionBox" TextChanged="GameVersionBox_TextChanged" /></StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Загрузчик" Style="{StaticResource DialogLabel}" />
                            <ComboBox x:Name="LoaderBox" SelectionChanged="LoaderBox_SelectionChanged">
                                <ComboBoxItem Content="Vanilla" /><ComboBoxItem Content="Fabric" /><ComboBoxItem Content="Forge" /><ComboBoxItem Content="NeoForge" /><ComboBoxItem Content="Quilt" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Версия загрузчика" Style="{StaticResource DialogLabel}" />
                            <ComboBox x:Name="LoaderVersionBox" ItemsSource="{Binding LoaderVersions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" />
                            <TextBlock x:Name="LoaderVersionStatusText" Style="{StaticResource CaptionText}" Margin="2,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,24" />
                    <TextBlock Text="Производительность" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Минимум памяти, МБ" Style="{StaticResource DialogLabel}" /><TextBox x:Name="MinRamBox" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Максимум памяти, МБ" Style="{StaticResource DialogLabel}" /><TextBox x:Name="MaxRamBox" /></StackPanel>
                    </Grid>
                    <TextBlock Text="Путь к Java (необязательно)" Style="{StaticResource DialogLabel}" Margin="0,14,0,0" />
                    <TextBox x:Name="JavaPathBox" />

                    <Expander Header="Дополнительно" Margin="0,20,0,0">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="ID профиля запуска" Style="{StaticResource DialogLabel}" />
                            <TextBox x:Name="LaunchVersionBox" />
                            <TextBlock Text="Оставьте пустым для автоматической установки выбранного загрузчика." Style="{StaticResource CaptionText}" Margin="2,5,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
