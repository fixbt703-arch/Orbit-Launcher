<Window x:Class="OrbitLauncher.Dialogs.OrbitConnectDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Orbit Connect" Width="620" Height="700" MinWidth="520" MinHeight="560" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="Transparent">
  <Border Style="{StaticResource WindowFrame}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
      <Grid Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <StackPanel Margin="24,0" VerticalAlignment="Center" Orientation="Horizontal">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}" Foreground="{DynamicResource PrimaryLightBrush}"/>
          <TextBlock Text="Orbit Connect" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0"/>
        </StackPanel>
        <Button Width="48" HorizontalAlignment="Right" Style="{StaticResource TitleBarButton}" Click="Close_Click" ToolTip="Закрыть" IsCancel="True">
          <ContentControl Content="" Style="{StaticResource SmoothActionIcon}"/>
        </Button>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,24,26,20">
          <TextBlock Name="InstanceText" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="Играйте вместе в своём мире" Style="{StaticResource MutedText}" Margin="0,6,0,22"/>
          <TextBlock Text="Ваш мир" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Запустите сборку, зайдите в мир и нажмите «Открыть для сети». Приглашение появится здесь автоматически." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
          <TextBox Name="CodeBox" IsReadOnly="True" Visibility="Collapsed" TextWrapping="Wrap" MaxHeight="78" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Приглашение в ваш мир" Margin="0,0,0,10"/>
          <Button Name="CopyButton" Content="Скопировать приглашение" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" IsEnabled="False" Click="Copy_Click"/>
          <Expander Header="Указать LAN-порт вручную" Margin="0,12,0,0">
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox Name="PortBox" MaxLength="5" AutomationProperties.Name="LAN-порт Minecraft" VerticalContentAlignment="Center"/>
              <Button Name="HostButton" Grid.Column="1" Content="Открыть мир" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Host_Click"/>
            </Grid>
          </Expander>
          <Separator Margin="0,22"/>
          <TextBlock Text="Мир друга" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Вставьте приглашение Orbit Connect или код Terracotta." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,10"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Name="InviteBox" MaxLength="4096" VerticalContentAlignment="Center" AutomationProperties.Name="Приглашение друга" KeyDown="Invite_KeyDown"/>
            <Button Name="JoinButton" Grid.Column="1" Content="Подключиться" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Join_Click"/>
          </Grid>
          <Border Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,22,0,0">
            <StackPanel>
              <TextBlock Name="PhaseText" Text="Ожидание" FontWeight="SemiBold"/>
              <TextBlock Name="StatusText" Text="Откройте мир для сети или вставьте приглашение друга." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock Name="PingText" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
              <Button Name="AddressButton" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed" Click="Address_Click"/>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,14,0,0"><Hyperlink Click="Credits_Click">EasyTier · Terracotta © burningtnt</Hyperlink></TextBlock>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
        <Grid><TextBlock Text="Закрытие окна не прерывает игру" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,165,0"/>
          <Button Name="StopButton" Content="Отключить" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="Stop_Click" IsEnabled="False"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
