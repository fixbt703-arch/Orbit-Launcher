<UserControl x:Class="OrbitLauncher.Controls.ElySkinsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="AccountStrip" Style="{StaticResource CardBorder}" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock x:Name="AccountTitle" Text="Аккаунт Ely.by" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="AccountHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Button x:Name="DisconnectButton" Grid.Column="1" Content="Выйти из Ely.by" Visibility="Collapsed" Style="{StaticResource QuietButton}" Click="Disconnect_Click"/>
      </Grid>
    </Border>
    <ScrollViewer x:Name="Overview" Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border Style="{StaticResource CardBorder}" Padding="24">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Margin="0,0,24,0" Padding="16" MinHeight="232">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Текущий скин" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"/>
                <Image x:Name="HeadPreview" Grid.Row="1" Width="104" Height="104" Margin="0,20" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" Visibility="Collapsed" AutomationProperties.Name="Предпросмотр головы текущего скина"/>
                <ContentControl x:Name="PreviewFallback" Grid.Row="1" Content="&#xEB4D;" Style="{StaticResource SmoothActionIcon}" Width="52" Height="52" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="PreviewName" Grid.Row="2" Text="Ely.by" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="SkinHeading" Text="Ваш образ в Minecraft" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="SkinDescription" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,20"/>
              <Button x:Name="ConnectButton" Content="Войти в Ely.by" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Connect_Click"/>
              <WrapPanel x:Name="SkinActions" Visibility="Collapsed">
                <Button x:Name="UploadButton" Content="Загрузить PNG" Style="{StaticResource PrimaryButton}" Click="Upload_Click" Margin="0,0,12,12"/>
                <Button x:Name="ManageButton" Content="Выбрать на Ely.by" Style="{StaticResource SecondaryButton}" Click="Manage_Click" Margin="0,0,0,12"/>
              </WrapPanel>
              <Button x:Name="RefreshButton" Content="Обновить скин" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="Refresh_Click" Visibility="Collapsed"/>
              <TextBlock Text="PNG · 64 × 64 пикселя · до 192 КБ" Style="{StaticResource CaptionText}" Margin="0,12,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border x:Name="StatusPanel" Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,12,0,0" Visibility="Collapsed">
          <StackPanel>
            <ProgressBar x:Name="SkinProgress" IsIndeterminate="True" Height="3" Margin="0,0,0,10" Visibility="Collapsed" AutomationProperties.Name="Обновление скина"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </Border>
        <StackPanel Margin="4,20,4,8">
          <TextBlock Text="Как применить скин" FontWeight="SemiBold"/>
          <TextBlock Text="Выберите образ на сайте Ely.by и нажмите «Надеть». Затем вернитесь сюда и запустите Minecraft заново." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
          <TextBlock Text="Сайт может попросить отдельный вход в тот же аккаунт Ely.by." TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid x:Name="Portal" Grid.RowSpan="2" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,12">
        <WrapPanel>
          <Button x:Name="BackButton" Content="К моему скину" Style="{StaticResource SecondaryButton}" Click="Back_Click" Margin="0,0,12,8"/>
          <Button Content="Повторить" Style="{StaticResource QuietButton}" Click="Retry_Click" Margin="0,0,12,8"/>
          <Button x:Name="RuntimeButton" Content="Установить WebView2" Style="{StaticResource QuietButton}" Click="Runtime_Click" Visibility="Collapsed" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock x:Name="PortalHint" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
      </StackPanel>
      <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource InputBrush}">
        <Grid>
          <wv:WebView2 x:Name="Browser" DefaultBackgroundColor="#121827" Visibility="Collapsed"/>
          <TextBlock x:Name="BrowserStatus" Text="Подключение к Ely.by…" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
