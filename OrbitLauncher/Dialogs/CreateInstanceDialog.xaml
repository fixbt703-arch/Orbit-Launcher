<Window x:Class="OrbitLauncher.Dialogs.CreateInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:OrbitLauncher.Models"
        Title="Новая сборка" Width="940" Height="720" MinWidth="860" MinHeight="660"
        ResizeMode="CanResize" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="Transparent">
    <Window.Resources>
        <Style x:Key="LoaderCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#111927" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#172235" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#202842" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowFrame}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="70" /></Grid.RowDefinitions>

            <Grid Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource PrimaryGradient}">
                        <TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Новая сборка" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Настройте игру и загрузчик" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="48" Style="{StaticResource TitleBarButton}" Click="Cancel_Click">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource FluentIcon}" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Background="#C80A101C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,0">
                    <StackPanel Margin="22">
                        <TextBlock Text="ОФОРМЛЕНИЕ" Style="{StaticResource EyebrowText}" />
                        <Border Width="104" Height="104" HorizontalAlignment="Left" CornerRadius="22" Background="#17243A"
                                BorderBrush="#31425E" BorderThickness="1" ClipToBounds="True" Margin="0,13,0,18">
                            <Grid>
                                <TextBlock x:Name="DefaultIconGlyph" Text="&#xE7B8;" Style="{StaticResource FluentIcon}" FontSize="38"
                                           Foreground="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="IconPreview" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ChooseIcon_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" Style="{StaticResource FluentIcon}" Margin="0,0,8,0" /><TextBlock Text="Выбрать иконку" /></StackPanel>
                        </Button>

                        <TextBlock Text="Название сборки" Style="{StaticResource DialogLabel}" Margin="0,24,0,0" />
                        <TextBox x:Name="NameBox" Text="Новая сборка" />

                        <Border Style="{StaticResource SubtleCard}" Margin="0,22,0,0">
                            <StackPanel>
                                <TextBlock Text="Отдельная среда" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Миры, моды и настройки этой сборки будут храниться отдельно." Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="26,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Версия Minecraft" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Сначала выберите версию игры, затем загрузчик и его версию." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Style="{StaticResource StatusPill}">
                            <TextBlock x:Name="VersionLoadingText" Text="Загрузка…" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,10">
                        <TextBox x:Name="VersionSearchBox" TextChanged="VersionSearchBox_TextChanged" />
                        <TextBlock Text="Поиск версии игры">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource InputPlaceholder}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=VersionSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="VersionList" ItemsSource="{Binding VisibleVersions}" SelectionChanged="VersionList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MinecraftVersionInfo}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="95" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                    <Border Grid.Column="1" Style="{StaticResource TagPill}" HorizontalAlignment="Left"><TextBlock Text="{Binding TypeDisplay}" FontSize="9" /></Border>
                                    <TextBlock Grid.Column="2" Text="{Binding ReleaseTime, StringFormat={}{0:dd.MM.yyyy}}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="Загрузчик" Style="{StaticResource DialogLabel}" />
                        <UniformGrid Columns="5">
                            <RadioButton x:Name="VanillaLoader" Tag="Vanilla" GroupName="Loader" IsChecked="True" Style="{StaticResource LoaderCard}" Checked="Loader_Checked" Margin="0,0,5,0">
                                <StackPanel><TextBlock Text="Vanilla" FontWeight="SemiBold" /><TextBlock Text="Без модов" Style="{StaticResource CaptionText}" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="FabricLoader" Tag="Fabric" GroupName="Loader" Style="{StaticResource LoaderCard}" Checked="Loader_Checked" Margin="5,0">
                                <StackPanel><TextBlock Text="Fabric" FontWeight="SemiBold" /><TextBlock Text="Лёгкий" Style="{StaticResource CaptionText}" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ForgeLoader" Tag="Forge" GroupName="Loader" Style="{StaticResource LoaderCard}" Checked="Loader_Checked" Margin="5,0">
                                <StackPanel><TextBlock Text="Forge" FontWeight="SemiBold" /><TextBlock Text="Классический" Style="{StaticResource CaptionText}" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NeoForgeLoader" Tag="NeoForge" GroupName="Loader" Style="{StaticResource LoaderCard}" Checked="Loader_Checked" Margin="5,0">
                                <StackPanel><TextBlock Text="NeoForge" FontWeight="SemiBold" /><TextBlock Text="Современный" Style="{StaticResource CaptionText}" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="QuiltLoader" Tag="Quilt" GroupName="Loader" Style="{StaticResource LoaderCard}" Checked="Loader_Checked" Margin="5,0,0,0">
                                <StackPanel><TextBlock Text="Quilt" FontWeight="SemiBold" /><TextBlock Text="Модульный" Style="{StaticResource CaptionText}" /></StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Версия загрузчика" Style="{StaticResource DialogLabel}" />
                            <ComboBox x:Name="LoaderVersionCombo" ItemsSource="{Binding LoaderVersions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="LoaderVersionStatusText" Text="Для Vanilla не требуется" Style="{StaticResource CaptionText}" VerticalAlignment="Bottom" Margin="0,0,0,11" />
                    </Grid>

                    <Expander Grid.Row="5" Header="Память" Margin="0,14,0,0">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Минимум, МБ" Style="{StaticResource DialogLabel}" /><TextBox x:Name="MinRamBox" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Максимум, МБ" Style="{StaticResource DialogLabel}" /><TextBox x:Name="MaxRamBox" /></StackPanel>
                        </Grid>
                    </Expander>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
                <Grid>
                    <TextBlock Text="Файлы игры будут загружены при первом запуске." Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Cancel_Click" />
                        <Button x:Name="CreateButton" Content="Создать сборку" Style="{StaticResource PrimaryButton}" Click="Create_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
